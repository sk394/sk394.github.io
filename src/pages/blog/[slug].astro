---
import { loadContent, fmtDay, postUrl } from "../../content/load.ts";
import { icon } from "../../icons/index.ts";
import type { Post } from "../../content/schema.ts";
import Fonts from "../../components/Fonts.astro";
import "../../styles/tokens.css";
import "../../styles/post.css";

export function getStaticPaths() {
  const { posts, profile } = loadContent();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      author: profile.name,
      related: posts.filter((p) => p.categoryId === post.categoryId && p.id !== post.id).slice(0, 4),
    },
  }));
}

type Props = { post: Post; author: string; related: Post[] };
const { post, author, related } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const u = (path: string) => base + path.replace(/^\{\{BASE\}\}/, "");
const home = new URL(import.meta.env.BASE_URL, Astro.site).href;
const abs = (path: string) => new URL(u(path), Astro.site).href;
const url = abs(postUrl(post));
const image = post.og ? abs(post.og) : new URL("og.png", home).href;
const description = post.summary ?? `${post.category}, by ${author}`;
const wheel = u(`/#/blog/${post.categoryId}`);
const html = post.html.replaceAll("{{BASE}}", base);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description,
  datePublished: post.date,
  image,
  url,
  keywords: post.tags,
  author: { "@type": "Person", name: author, url: home },
};
---
<!doctype html>
<html lang="en" data-view="post">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{post.title} · {author}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#0a0a0c" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="article:published_time" content={post.date} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <Fonts />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, String.fromCharCode(92) + "u003c")} />
  </head>
  <body>
    <a class="skip" href="#post">Skip to the post</a>
    <div class="post-bg" aria-hidden="true">
      <picture>
        <source type="image/avif" srcset={`${u("/bg/city-blur-960.avif")} 960w, ${u("/bg/city-blur-1920.avif")} 1920w`} sizes="100vw" />
        <img src={u("/bg/city-blur-960.webp")} alt="" width="1920" height="1080" decoding="async" />
      </picture>
    </div>

    <header class="topbar">
      <a class="brand" href={u("/")}>{author}</a>
      <div class="tools">
        <a class="tool back" href={wheel} data-plain={u("/#r-blog")}><Fragment set:html={icon("back")} /><span>{post.category}</span></a>
      </div>
    </header>

    <main id="post" tabindex="-1">
      <article class="post">
        <header class="post-head">
          <p class="post-meta"><span>{post.category}</span><time datetime={post.date}>{fmtDay(post.date)}</time><span>{post.minutes} min read</span></p>
          <h1>{post.title}</h1>
          {post.summary && <p class="post-sum">{post.summary}</p>}
        </header>
        {post.cover && <img class="post-cover" src={u(post.cover.src)} alt="" width={post.cover.width} height={post.cover.height} fetchpriority="high" decoding="async" />}
        <div class="prose" set:html={html} />
        {post.tags.length > 0 && <ul class="post-tags" aria-label="Topics">{post.tags.map((t) => <li>{t}</li>)}</ul>}
      </article>

      {related.length > 0 && (
        <nav class="post-more" aria-labelledby="more-h">
          <h2 id="more-h">More in {post.category}</h2>
          <ul>{related.map((p) => <li><a href={u(postUrl(p))}>{p.title}</a> <span>{fmtDay(p.date)}</span></li>)}</ul>
        </nav>
      )}
    </main>

    <script is:inline>
      (function () {
        var back = document.querySelector(".back");
        try { if (localStorage.getItem("folio:view") === "plain") back.href = back.dataset.plain; } catch (e) {}
        addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !e.defaultPrevented && !document.fullscreenElement) location.href = back.href;
        });

        // HTML blocks report their content height. A page sized in vh would grow forever: if two
        // resizes in a row add the same amount, go back to the first height.
        var frames = new Map();
        addEventListener("message", function (e) {
          var h = e.data && e.data.folioHeight;
          if (typeof h !== "number" || !isFinite(h)) return;
          document.querySelectorAll("iframe.html-block").forEach(function (f) {
            if (f.contentWindow !== e.source) return;
            var s = frames.get(f) || { first: 0, last: 0, grow: 0, done: false };
            frames.set(f, s);
            if (s.done) return;
            h = Math.min(12000, Math.max(60, h));
            if (!s.first) s.first = h;
            var d = h - s.last;
            if (s.last && d > 0 && d === s.grow) { s.done = true; h = Math.max(s.first, 420); }
            s.grow = s.last ? d : 0;
            s.last = h;
            f.style.height = h + "px";
          });
        });
      })();
    </script>
  </body>
</html>
